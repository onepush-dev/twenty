# Twenty CRM v2.48.0 on Railway: every variable with its TEMPLATE expression.
# ${{secret(N)}} values are generated per deploy; everything else is a literal or a reference.
# Nothing here needs to be filled in at deploy time.

### twenty (server; public, port 3000, health /healthz, volume /app/packages/twenty-server/.local-storage)
NODE_PORT=3000
PORT=3000
SERVER_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
APP_SECRET=${{secret(32)}}
ENCRYPTION_KEY=${{secret(32)}}
STORAGE_TYPE=local
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
RAILWAY_RUN_UID=0

### twenty-worker (private, start command: /app/entrypoint.sh yarn worker:prod)
SERVER_URL=https://${{twenty.RAILWAY_PUBLIC_DOMAIN}}
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
APP_SECRET=${{twenty.APP_SECRET}}
ENCRYPTION_KEY=${{twenty.ENCRYPTION_KEY}}
STORAGE_TYPE=local
DISABLE_DB_MIGRATIONS=true
DISABLE_CRON_JOBS_REGISTRATION=true

### Postgres (ghcr.io/railwayapp-templates/postgres-ssl:16.15, volume /var/lib/postgresql/data)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")}}
POSTGRES_DB=railway
PGDATA=/var/lib/postgresql/data/pgdata
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432
PGUSER=${{POSTGRES_USER}}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGDATABASE=${{POSTGRES_DB}}
DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}
SSL_CERT_DAYS=820
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60

### Redis (redis:8.2.10, volume /data, start command in railway/redis-start-command.txt)
REDIS_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")}}
REDISHOST=${{RAILWAY_PRIVATE_DOMAIN}}
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=${{REDIS_PASSWORD}}
REDIS_URL=redis://${{REDISUSER}}:${{REDIS_PASSWORD}}@${{REDISHOST}}:${{REDISPORT}}
